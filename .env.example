

# Signs the log-in cookie. Optional locally; required on Render. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=

# --- Production (Render) ---
# Leave DATABASE_URL unset locally to use the SQLite file in data/. Set it to a Neon/Postgres connection string in production.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# WRITE_LIMIT_PER_MINUTE=60
# AUTH_LIMIT_PER_15_MIN=10
# DAILY_SIGNUP_LIMIT=20
# DAILY_AI_LIMIT=25
# MAX_BULK_LINKS=25
